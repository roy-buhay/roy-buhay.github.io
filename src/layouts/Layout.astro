---
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import { ViewTransitions } from "astro:transitions";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description,
  image = "/images/meta-cover.jpg",
  type = "website",
  structuredData,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://roy-buhay.github.io");
const canonicalPath =
  Astro.url.pathname === "/"
    ? "/"
    : `${Astro.url.pathname.replace(/\/$/, "")}/`;
const canonicalUrl = new URL(canonicalPath, siteUrl);
const socialImageUrl = new URL(image, siteUrl);
const personId = new URL("/#person", siteUrl).href;
const websiteId = new URL("/#website", siteUrl).href;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: "Roy Jose Buhay",
      url: new URL("/", siteUrl).href,
      jobTitle: "Design Engineer and Full-Stack Developer",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Cebu City",
        addressCountry: "PH",
      },
      sameAs: ["https://www.linkedin.com/in/roy-buhay/"],
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      name: "Roy Jose Buhay",
      url: new URL("/", siteUrl).href,
      publisher: { "@id": personId },
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl.href}#webpage`,
      url: canonicalUrl.href,
      name: title,
      description,
      isPartOf: { "@id": websiteId },
      about: { "@id": personId },
    },
    ...(structuredData ? [structuredData] : []),
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ViewTransitions />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Roy Jose Buhay" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="Roy Jose Buhay portfolio preview" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="Roy Jose Buhay portfolio preview" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="ambient-sphere" aria-hidden="true" hidden>
      <span></span>
      <i class="sphere-fragment sphere-fragment--one"></i>
      <i class="sphere-fragment sphere-fragment--two"></i>
      <i class="sphere-fragment sphere-fragment--three"></i>
      <i class="sphere-fragment sphere-fragment--four"></i>
      <i class="sphere-fragment sphere-fragment--five"></i>
    </div>
    <svg class="screen-noise" aria-hidden="true" focusable="false">
      <filter id="screen-noise-filter" x="0" y="0" width="100%" height="100%">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.78"
          numOctaves="4"
          seed="12"
          stitchTiles="stitch"
        />
        <feColorMatrix type="saturate" values="0" />
      </filter>
      <rect width="100%" height="100%" filter="url(#screen-noise-filter)" />
    </svg>
    <svg class="noise-definitions" aria-hidden="true" focusable="false">
      <defs>
        <filter id="procedural-noise" x="-20%" y="-20%" width="140%" height="140%">
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.75"
            numOctaves="3"
            seed="4"
            stitchTiles="stitch"
            result="noise"
          />
          <feColorMatrix in="noise" type="saturate" values="0" result="monochrome-noise" />
          <feComponentTransfer in="monochrome-noise" result="soft-noise">
            <feFuncA type="linear" slope="0.35" />
          </feComponentTransfer>
          <feBlend in="SourceGraphic" in2="soft-noise" mode="soft-light" />
        </filter>
        <filter id="icon-noise" x="0" y="0" width="100%" height="100%">
          <feTurbulence
            type="fractalNoise"
            baseFrequency="1.1"
            numOctaves="3"
            seed="7"
            stitchTiles="stitch"
            result="icon-grain"
          />
          <feColorMatrix in="icon-grain" type="saturate" values="0" result="monochrome-icon-grain" />
          <feComponentTransfer in="monochrome-icon-grain" result="contrasted-icon-grain">
            <feFuncR type="linear" slope="1.5" intercept="-0.25" />
            <feFuncG type="linear" slope="1.5" intercept="-0.25" />
            <feFuncB type="linear" slope="1.5" intercept="-0.25" />
            <feFuncA type="linear" slope="0.65" />
          </feComponentTransfer>
          <feBlend in="SourceGraphic" in2="contrasted-icon-grain" mode="soft-light" />
        </filter>
      </defs>
    </svg>
    <Header />
    <slot />
    <Footer />

    <script>
      const setupAmbientSphere = () => {
        const sphere = document.querySelector<HTMLElement>(".ambient-sphere");
        const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
        const ambientWindow = window as Window & {
          __ambientSphereAbort?: AbortController;
        };

        ambientWindow.__ambientSphereAbort?.abort();

        if (!sphere || sphere.hidden || motionQuery.matches) return;

        const controller = new AbortController();
        ambientWindow.__ambientSphereAbort = controller;
        const sphereShape = sphere.querySelector<HTMLElement>("span");

        let frame = 0;
        let morphTimer = 0;
        const driftStartedAt = performance.now();
        const driftCycle = 64000;

        const randomBetween = (min: number, max: number) =>
          Math.random() * (max - min) + min;

        const morphSphere = () => {
          if (!sphereShape || controller.signal.aborted) return;

          const duration = randomBetween(7, 11);
          const horizontalRadius = [
            randomBetween(30, 42),
            randomBetween(58, 70),
            randomBetween(34, 46),
            randomBetween(54, 66),
          ].map(Math.round);
          const verticalRadius = [
            randomBetween(56, 70),
            randomBetween(32, 44),
            randomBetween(58, 70),
            randomBetween(30, 42),
          ].map(Math.round);

          sphereShape.style.setProperty("--morph-duration", `${duration}s`);
          sphereShape.style.borderRadius = `${horizontalRadius.join("% ")}% / ${verticalRadius.join("% ")}%`;
          sphereShape.style.transform = `scaleX(${randomBetween(0.98, 1.12)}) scaleY(${randomBetween(0.82, 0.96)}) rotate(${randomBetween(-7, 7)}deg)`;

          morphTimer = window.setTimeout(morphSphere, duration * 900);
        };

        const render = (timestamp: number) => {
          const progress =
            ((timestamp - driftStartedAt) / driftCycle) * Math.PI * 2;
          const horizontalPosition = 0.5 + Math.cos(progress) * 0.25;
          const verticalPosition = 0.06 + Math.sin(progress) * 0.07;

          sphere.style.setProperty(
            "--sphere-x",
            `${window.innerWidth * horizontalPosition}px`,
          );
          sphere.style.setProperty(
            "--sphere-y",
            `${window.innerHeight * verticalPosition}px`,
          );

          frame = requestAnimationFrame(render);
        };

        controller.signal.addEventListener(
          "abort",
          () => {
            cancelAnimationFrame(frame);
            clearTimeout(morphTimer);
          },
          { once: true },
        );

        morphTimer = window.setTimeout(morphSphere, 700);
        frame = requestAnimationFrame(render);
      };

      const disableImageDragging = () => {
        document.querySelectorAll<HTMLImageElement>("img").forEach((image) => {
          image.draggable = false;
        });
      };

      document.addEventListener("astro:page-load", setupAmbientSphere);
      document.addEventListener("astro:page-load", disableImageDragging);
      disableImageDragging();
    </script>

    <style lang="scss" is:global>
      :root {
        --mobile-width: 560px;
        --custom-cursor: url("/cursor2.png") 4 4, auto;

        --base-color: rgb(4 30 57);
        --main-color: #f8f9f9;
        --secondary-color: rgb(7 53 95);
        --secondary-hover-color: rgb(4 47 86);
        --tertiary-color: rgb(4 47 84);
        --tertiary-hover-color: rgb(4 44 80);
        --close-bg-color: rgb(27 68 113);
        --close-text-color: rgb(91 119 148);

        --page-title-color: #000;
        --page-subtitle-color: #000;
        --title-color: #000;
        --description-color: #9b9b9b;
        --page-title: 800 3.4rem/1 "JetBrains Mono", monospace;
        --page-subtitle: 800 1.8rem/1 "JetBrains Mono", monospace;
        --page-subtitle-mono: 600 1.7rem/1.4 "JetBrains Mono", monospace;
        --title: 800 1rem/1 "JetBrains Mono", monospace;
        --description: 300 0.85rem/1.4 "JetBrains Mono", monospace;

        --max-width: 1250px;
        --max-height: 42rem;
        --card-padding: 2.3rem;

        --corner-radius: 0.4rem;

        --base-font: "JetBrains Mono", monospace;

        --accent: 136, 58, 234;
        --accent-light: 224, 204, 250;
        --accent-dark: 49, 10, 101;
        --accent-gradient: linear-gradient(
          45deg,
          rgb(var(--accent)),
          rgb(var(--accent-light)) 30%,
          white 60%
        );
      }

      @media screen and (max-width: 900px) {
        :root {
          --max-height: unset;
          --content-mainpadding: 3rem 1rem 0;
          --content-padding: 1rem 1rem;
          --page-title: 800 2.2rem/1 "JetBrains Mono", monospace;
          --page-subtitle: bold 1.5rem/1 "JetBrains Mono", monospace;
        }
      }

      ::-webkit-scrollbar {
        width: 6px;
        height: 5px;
      }
      ::-webkit-scrollbar-track {
        /* background: #041f38; */
      }
      ::-webkit-scrollbar-thumb {
        background: #0c3e6b;
        border-radius: 0.5rem;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #9e9e9e;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        -moz-text-size-adjust: none;
        -webkit-text-size-adjust: none;
        text-size-adjust: none;
      }

      body,
      h1,
      h2,
      h3,
      h4,
      p,
      figure,
      blockquote,
      dl,
      dd {
        margin-block-end: 0;
      }

      ul[role="list"],
      ol[role="list"] {
        list-style: none;
      }

      body {
        min-height: 100vh;
        margin: 0;
        font-synthesis: none;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      h1,
      h2,
      h3,
      h4,
      button,
      input,
      label {
        line-height: 1.1;
      }

      h1,
      h2,
      h3,
      h4 {
        text-wrap: balance;
      }

      a:not([class]) {
        text-decoration-skip-ink: auto;
        color: #000;
      }

      a,
      a:visited {
        color: #000;
      }

      :where(a, button) {
        scale: 1;
        transform-origin: center;
        font-family: "Inter", sans-serif;
        cursor: var(--custom-cursor);
        transition: scale 160ms cubic-bezier(0.22, 1, 0.36, 1);
        -webkit-tap-highlight-color: transparent;
      }

      :where(a) {
        display: inline-block;
      }

      :where(a, button):active {
        scale: 0.97;
        transition-duration: 70ms;
      }

      img,
      picture {
        max-width: 100%;
        display: block;
        -webkit-user-drag: none;
        user-select: none;
        -webkit-user-select: none;
      }

      input,
      textarea,
      select {
        font: inherit;
      }

      button {
        font: inherit;
        font-family: "Inter", sans-serif;
      }

      textarea:not([rows]) {
        min-height: 10em;
      }

      :target {
        scroll-margin-block: 5ex;
      }

      html {
        scroll-behavior: smooth;
        height: 100%;
        width: 100%;
      }
      body {
        font-family: var(--base-font);
        cursor: var(--custom-cursor);
        background: var(--main-color);
        width: 100%;
        height: 100%;
        position: relative;
        isolation: isolate;

        .ambient-sphere {
          --sphere-x: 72vw;
          --sphere-y: 10vh;
          --sphere-gradient: linear-gradient(
            135deg,
            rgba(171, 226, 255, 0.98) 0%,
            rgba(74, 158, 255, 0.96) 42%,
            rgba(20, 91, 222, 0.6) 72%,
            rgba(15, 63, 166, 0.5) 100%
          );

          position: fixed;
          top: 0;
          left: 0;
          z-index: 0;
          width: clamp(28rem, 54vw, 52rem);
          aspect-ratio: 1;
          pointer-events: none;
          opacity: 0.08;
          filter: blur(30px) saturate(100%);
          transform: translate3d(var(--sphere-x), var(--sphere-y), 0)
            translate(-50%, -50%);
          will-change: transform;

          span {
            position: absolute;
            inset: 22% 8%;
            display: block;
            border-radius: 53% 47% 58% 42% / 45% 55% 45% 55%;
            background: var(--sphere-gradient);
            box-shadow:
              0 0 4.5rem rgba(33, 119, 235, 0.42),
              inset -2rem -1rem 4rem rgba(15, 73, 181, 0.22),
              inset 2rem 2rem 4rem rgba(171, 226, 255, 0.36);
            transition:
              border-radius var(--morph-duration, 9s) ease-in-out,
              transform var(--morph-duration, 9s) ease-in-out;
            animation: sphereColorCycle 28s linear infinite;
          }

          .sphere-fragment {
            position: absolute;
            display: block;
            aspect-ratio: 1;
            background: var(--sphere-gradient);
            border-radius: 55% 45% 62% 38% / 44% 58% 42% 56%;
            box-shadow: 0 0 2.5rem rgba(33, 119, 235, 0.32);
            animation:
              sphereColorCycle 28s linear infinite,
              smallFragmentDrift var(--fragment-speed, 20s) ease-in-out infinite alternate;
            animation-delay: 0s, var(--fragment-delay, 0s);

            &--one {
              --fragment-x: 16%;
              --fragment-y: -12%;
              --fragment-rotation: 8deg;
              --fragment-speed: 18s;
              --fragment-delay: -4s;
              top: 21%;
              left: 88%;
              width: 9%;
            }

            &--two {
              --fragment-x: -14%;
              --fragment-y: -18%;
              --fragment-rotation: -9deg;
              --fragment-speed: 22s;
              --fragment-delay: -11s;
              top: 17%;
              left: 5%;
              width: 6%;
            }

            &--three {
              --fragment-x: -16%;
              --fragment-y: 12%;
              --fragment-rotation: 10deg;
              --fragment-speed: 20s;
              --fragment-delay: -7s;
              top: 76%;
              left: 8%;
              width: 8%;
            }

            &--four {
              --fragment-x: 18%;
              --fragment-y: 14%;
              --fragment-rotation: -10deg;
              --fragment-speed: 24s;
              --fragment-delay: -16s;
              top: 78%;
              left: 88%;
              width: 5%;
            }

            &--five {
              --fragment-x: 8%;
              --fragment-y: -20%;
              --fragment-rotation: 12deg;
              --fragment-speed: 17s;
              --fragment-delay: -9s;
              top: 3%;
              left: 49%;
              width: 4%;
            }
          }
        }

        .screen-noise {
          position: fixed;
          inset: 0;
          z-index: 1;
          width: 100vw;
          height: 100vh;
          pointer-events: none;
          opacity: 0.1;
          mix-blend-mode: multiply;
        }

        .noise-definitions {
          position: absolute;
          width: 0;
          height: 0;
          overflow: hidden;
        }

        @supports (hanging-punctuation: first) and (font: -apple-system-body)
          and (-webkit-appearance: none) {
          &:after {
            background: radial-gradient(
              circle at 25% 20%,
              rgba(0, 0, 0, 0),
              rgb(67, 103, 116) 47.06%
            );
          }
        }
      }

      section {
        margin-bottom: 5.2rem;

        &:last-of-type {
          margin-bottom: 8rem;
        }
      }

      main > * {
        animation: fadeInUp 600ms cubic-bezier(0.22, 1, 0.36, 1) both;
      }

      main > :nth-child(1) {
        animation-delay: 80ms;
      }

      main > :nth-child(2) {
        animation-delay: 180ms;
      }

      main > :nth-child(3) {
        animation-delay: 280ms;
      }

      main > :nth-child(4) {
        animation-delay: 380ms;
      }

      main > :nth-child(n + 5) {
        animation-delay: 480ms;
      }

      h1 {
        text-wrap: balance;
        font: 500 1.85rem/1.1 "Inter", monospace;
        color: #000;
        letter-spacing: 0.8px;
      }

      h2 {
        text-wrap: balance;
        font: 400 1rem/1 "Inter", monospace;
        color: #000;
        margin-bottom: 1.5rem;
        letter-spacing: 0.5px;
      }

      h3 {
        font: var(--page-subtitle);
        color: var(--page-subtitle-color);
        margin-top: 0;
        margin-bottom: 0.4rem;
      }

      p {
        // text-wrap: balance;
        letter-spacing: 0.3px;
        font: 300 0.85rem/1.7 "Inter", sans-serif;
        color: #6c6c6c;
      }

      main,
      header {
        max-width: 37rem;
        margin: 0 auto;
        padding: 0 1rem;
        position: relative;
        z-index: 2;

        @media screen and (min-width: 600px) {
          & {
            padding: 0;
          }
        }
      }

      footer {
        font: 300 0.7rem/1.7 "Inter",sans-serif;
        color: rgb(110, 110, 110);
        text-align: center;
        margin-bottom: 2rem;
        position: relative;
        z-index: 2;
      }

      /****************/
      /*  Animations  */
      /****************/
      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes slideUp {
        from {
          transform: translateY(100%);
        }

        to {
          transform: translateY(0);
        }
      }

      @keyframes slideDown {
        from {
          transform: translateY(0);
        }

        to {
          transform: translateY(250%);
        }
      }

      @keyframes float {
        0% {
          transform: translatey(0);
        }
        50% {
          transform: translatey(-4px);
        }
        100% {
          transform: translatey(0);
        }
      }

      @keyframes sphereColorCycle {
        from {
          filter: hue-rotate(0deg);
        }

        to {
          filter: hue-rotate(360deg);
        }
      }

      @keyframes smallFragmentDrift {
        from {
          transform: translate3d(0, 0, 0) rotate(0) scale(0.94);
        }

        to {
          transform: translate3d(
              var(--fragment-x),
              var(--fragment-y),
              0
            )
            rotate(var(--fragment-rotation)) scale(1.06);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        main > * {
          animation: none;
        }

        :where(a, button) {
          scale: 1;
          transition: none;
        }

        .ambient-sphere {
          --sphere-x: 75vw;
          --sphere-y: 10vh;

          span {
            transition: none;
            animation: none;
          }

          .sphere-fragment {
            animation: none;
          }
        }
      }
    </style>
  </body>
</html>
