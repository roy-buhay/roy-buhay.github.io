---
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import { ViewTransitions } from "astro:transitions";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ViewTransitions />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="Roy Jose Buhay - Software Developer" />
    <meta
      property="og:description"
      content="Software Developer | React | Next.js | React Native | Expo | TypeScript | Node.js | UI"
    />
    <meta property="og:image" content="/images/meta-cover.jpg" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta
      property="twitter:title"
      content="Roy Jose Buhay - Software Developer"
    />
    <meta
      property="twitter:description"
      content="Software Developer | React | Next.js | React Native | Expo | TypeScript | Node.js | UI"
    />
    <meta property="twitter:image" content="/images/meta-cover.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide.min.css"
      rel="stylesheet"
    />
  </head>
  <body>
    <svg class="noise-definitions" aria-hidden="true" focusable="false">
      <defs>
        <filter id="procedural-noise" x="-20%" y="-20%" width="140%" height="140%">
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.75"
            numOctaves="3"
            seed="4"
            stitchTiles="stitch"
            result="noise"
          />
          <feColorMatrix in="noise" type="saturate" values="0" result="monochrome-noise" />
          <feComponentTransfer in="monochrome-noise" result="soft-noise">
            <feFuncA type="linear" slope="0.35" />
          </feComponentTransfer>
          <feBlend in="SourceGraphic" in2="soft-noise" mode="soft-light" />
        </filter>
        <filter id="icon-noise" x="0" y="0" width="100%" height="100%">
          <feTurbulence
            type="fractalNoise"
            baseFrequency="1.1"
            numOctaves="3"
            seed="7"
            stitchTiles="stitch"
            result="icon-grain"
          />
          <feColorMatrix in="icon-grain" type="saturate" values="0" result="monochrome-icon-grain" />
          <feComponentTransfer in="monochrome-icon-grain" result="contrasted-icon-grain">
            <feFuncR type="linear" slope="1.5" intercept="-0.25" />
            <feFuncG type="linear" slope="1.5" intercept="-0.25" />
            <feFuncB type="linear" slope="1.5" intercept="-0.25" />
            <feFuncA type="linear" slope="0.65" />
          </feComponentTransfer>
          <feBlend in="SourceGraphic" in2="contrasted-icon-grain" mode="soft-light" />
        </filter>
      </defs>
    </svg>
    <slot />
    <Footer />

    <style lang="scss" is:global>
      :root {
        --mobile-width: 560px;

        --base-color: rgb(4 30 57);
        --main-color: #f8f9f9;
        --secondary-color: rgb(7 53 95);
        --secondary-hover-color: rgb(4 47 86);
        --tertiary-color: rgb(4 47 84);
        --tertiary-hover-color: rgb(4 44 80);
        --close-bg-color: rgb(27 68 113);
        --close-text-color: rgb(91 119 148);

        --page-title-color: #000;
        --page-subtitle-color: #000;
        --title-color: #000;
        --description-color: #9b9b9b;
        --page-title: 800 3.4rem/1 "JetBrains Mono", monospace;
        --page-subtitle: 800 1.8rem/1 "JetBrains Mono", monospace;
        --page-subtitle-mono: 600 1.7rem/1.4 "JetBrains Mono", monospace;
        --title: 800 1rem/1 "JetBrains Mono", monospace;
        --description: 300 0.85rem/1.4 "JetBrains Mono", monospace;

        --max-width: 1250px;
        --max-height: 42rem;
        --card-padding: 2.3rem;

        --corner-radius: 0.4rem;

        --base-font: "JetBrains Mono", monospace;

        --accent: 136, 58, 234;
        --accent-light: 224, 204, 250;
        --accent-dark: 49, 10, 101;
        --accent-gradient: linear-gradient(
          45deg,
          rgb(var(--accent)),
          rgb(var(--accent-light)) 30%,
          white 60%
        );
      }

      @media screen and (max-width: 900px) {
        :root {
          --max-height: unset;
          --content-mainpadding: 3rem 1rem 0;
          --content-padding: 1rem 1rem;
          --page-title: 800 2.2rem/1 "JetBrains Mono", monospace;
          --page-subtitle: bold 1.5rem/1 "JetBrains Mono", monospace;
        }
      }

      ::-webkit-scrollbar {
        width: 6px;
        height: 5px;
      }
      ::-webkit-scrollbar-track {
        /* background: #041f38; */
      }
      ::-webkit-scrollbar-thumb {
        background: #0c3e6b;
        border-radius: 0.5rem;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #9e9e9e;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        -moz-text-size-adjust: none;
        -webkit-text-size-adjust: none;
        text-size-adjust: none;
      }

      body,
      h1,
      h2,
      h3,
      h4,
      p,
      figure,
      blockquote,
      dl,
      dd {
        margin-block-end: 0;
      }

      ul[role="list"],
      ol[role="list"] {
        list-style: none;
      }

      body {
        min-height: 100vh;
        margin: 0;
        font-synthesis: none;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      h1,
      h2,
      h3,
      h4,
      button,
      input,
      label {
        line-height: 1.1;
      }

      h1,
      h2,
      h3,
      h4 {
        text-wrap: balance;
      }

      a:not([class]) {
        text-decoration-skip-ink: auto;
        color: #000;
      }

      a,
      a:visited {
        color: #000;
      }

      :where(a, button) {
        scale: 1;
        transform-origin: center;
        font-family: "Inter", sans-serif;
        transition: scale 160ms cubic-bezier(0.22, 1, 0.36, 1);
        -webkit-tap-highlight-color: transparent;
      }

      :where(a) {
        display: inline-block;
      }

      :where(a, button):active {
        scale: 0.97;
        transition-duration: 70ms;
      }

      img,
      picture {
        max-width: 100%;
        display: block;
      }

      input,
      textarea,
      select {
        font: inherit;
      }

      button {
        font: inherit;
        font-family: "Inter", sans-serif;
      }

      textarea:not([rows]) {
        min-height: 10em;
      }

      :target {
        scroll-margin-block: 5ex;
      }

      html {
        scroll-behavior: smooth;
        height: 100%;
        width: 100%;
      }
      body {
        font-family: var(--base-font);
        background: var(--main-color);
        width: 100%;
        height: 100%;

        .noise-definitions {
          position: absolute;
          width: 0;
          height: 0;
          overflow: hidden;
        }

        @supports (hanging-punctuation: first) and (font: -apple-system-body)
          and (-webkit-appearance: none) {
          &:after {
            background: radial-gradient(
              circle at 25% 20%,
              rgba(0, 0, 0, 0),
              rgb(67, 103, 116) 47.06%
            );
          }
        }
      }

      section {
        margin-bottom: 5.2rem;

        &:last-of-type {
          margin-bottom: 8rem;
        }
      }

      main > * {
        animation: fadeInUp 600ms cubic-bezier(0.22, 1, 0.36, 1) both;
      }

      main > :nth-child(1) {
        animation-delay: 80ms;
      }

      main > :nth-child(2) {
        animation-delay: 180ms;
      }

      main > :nth-child(3) {
        animation-delay: 280ms;
      }

      main > :nth-child(4) {
        animation-delay: 380ms;
      }

      main > :nth-child(n + 5) {
        animation-delay: 480ms;
      }

      h1 {
        text-wrap: balance;
        font: 500 1.85rem/1.1 "Inter", monospace;
        color: #000;
        letter-spacing: 0.8px;
      }

      h2 {
        text-wrap: balance;
        font: 400 1rem/1 "Inter", monospace;
        color: #000;
        margin-bottom: 1.5rem;
        letter-spacing: 0.5px;
      }

      h3 {
        font: var(--page-subtitle);
        color: var(--page-subtitle-color);
        margin-top: 0;
        margin-bottom: 0.4rem;
      }

      p {
        text-wrap: balance;
        letter-spacing: 0.3px;
        font: 300 0.85rem/1.7 "Inter", sans-serif;
        color: #6c6c6c;
      }

      main,
      header {
        max-width: 37rem;
        margin: 0 auto;
        padding: 0 1rem;

        @media screen and (min-width: 600px) {
          & {
            padding: 0;
          }
        }
      }

      footer {
        font:
          300 0.65rem/1.65 "JetBrains Mono",
          monospace;
        color: rgb(65, 85, 102);
        text-align: center;
        margin-bottom: 2rem;
      }

      /****************/
      /*  Animations  */
      /****************/
      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes slideUp {
        from {
          transform: translateY(100%);
        }

        to {
          transform: translateY(0);
        }
      }

      @keyframes slideDown {
        from {
          transform: translateY(0);
        }

        to {
          transform: translateY(250%);
        }
      }

      @keyframes float {
        0% {
          transform: translatey(0);
        }
        50% {
          transform: translatey(-4px);
        }
        100% {
          transform: translatey(0);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        main > * {
          animation: none;
        }

        :where(a, button) {
          scale: 1;
          transition: none;
        }
      }
    </style>
  </body>
</html>
