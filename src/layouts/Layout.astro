---
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:title" content="Roy Jose Buhay - Software Developer" />
    <meta
      property="og:description"
      content="Software Developer | React | Next.js | React Native | Expo | TypeScript | Node.js | UI"
    />
    <meta property="og:image" content="/images/meta-cover.jpg" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta
      property="twitter:title"
      content="Roy Jose Buhay - Software Developer"
    />
    <meta
      property="twitter:description"
      content="Software Developer | React | Next.js | React Native | Expo | TypeScript | Node.js | UI"
    />
    <meta property="twitter:image" content="/images/meta-cover.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Chivo+Mono:wght@300;400;500;600;700;800&family=DM+Serif+Display&family=Karla:wght@300;400;500;600;700;800&family=Martian+Mono:wght@100..800&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide.min.css"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- {Astro.url.pathname !== "/" && <Header />} -->
    <slot />
    <Footer />

    <style is:global>
      :root {
        --mobile-width: 560px;

        --base-color: rgb(4 30 57);
        --main-color: rgb(7 41 76);
        --secondary-color: rgb(7 53 95);
        --secondary-hover-color: rgb(4 47 86);
        --tertiary-color: rgb(4 47 84);
        --tertiary-hover-color: rgb(4 44 80);
        --close-bg-color: rgb(27 68 113);
        --close-text-color: rgb(91 119 148);

        --page-title-color: #dee5ec;
        --page-subtitle-color: #fff;
        --title-color: #dee5ec;
        --description-color: rgb(115 138 158);
        --page-title: 800 3.4rem/1 "Chivo Mono", serif;
        --page-subtitle: 800 1.8rem/1 "Chivo Mono", serif;
        --page-subtitle-mono: 600 1.7rem/1.4 "Chivo Mono";
        --title: 800 1rem/1 "Karla", "Chivo Mono";
        --description: 300 0.85rem/1.4 "Chivo Mono";

        --max-width: 1250px;
        --max-height: 42rem;
        --card-padding: 2.3rem;

        --corner-radius: 0.4rem;

        --base-font: system-ui, sans-serif;

        --accent: 136, 58, 234;
        --accent-light: 224, 204, 250;
        --accent-dark: 49, 10, 101;
        --accent-gradient: linear-gradient(
          45deg,
          rgb(var(--accent)),
          rgb(var(--accent-light)) 30%,
          white 60%
        );
      }

      @media screen and (max-width: 900px) {
        :root {
          --max-height: unset;
          --content-mainpadding: 3rem 1rem 0;
          --content-padding: 1rem 1rem;
          --page-title: 800 2.2rem/1 "Chivo Mono", serif;
          --page-subtitle: bold 1.5rem/1 "Chivo Mono", serif;
        }
      }

      ::-webkit-scrollbar {
        width: 6px;
        height: 5px;
      }
      ::-webkit-scrollbar-track {
        /* background: #041f38; */
      }
      ::-webkit-scrollbar-thumb {
        background: #0c3e6b;
        border-radius: 0.5rem;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #9e9e9e;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        -moz-text-size-adjust: none;
        -webkit-text-size-adjust: none;
        text-size-adjust: none;
      }

      body,
      h1,
      h2,
      h3,
      h4,
      p,
      figure,
      blockquote,
      dl,
      dd {
        margin-block-end: 0;
      }

      ul[role="list"],
      ol[role="list"] {
        list-style: none;
      }

      body {
        min-height: 100vh;
        margin: 0;
        font-synthesis: none;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      h1,
      h2,
      h3,
      h4,
      button,
      input,
      label {
        line-height: 1.1;
      }

      h1,
      h2,
      h3,
      h4 {
        text-wrap: balance;
      }

      a:not([class]) {
        text-decoration-skip-ink: auto;
        color: currentColor;
      }

      img,
      picture {
        max-width: 100%;
        display: block;
      }

      input,
      button,
      textarea,
      select {
        font: inherit;
      }

      textarea:not([rows]) {
        min-height: 10em;
      }

      :target {
        scroll-margin-block: 5ex;
      }

      html {
        scroll-behavior: smooth;
        height: 100%;
        width: 100%;
      }
      body {
        font-family: var(--base-font);
        background: var(--main-color);
        width: 100%;
        height: 100%;
      }

      body:after {
        content: "";
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: radial-gradient(
            circle at 17% 0%,
            rgba(0, 0, 0, 0),
            rgb(0, 0, 0)
          ),
          url(/images/noise.svg);
        -webkit-filter: contrast(300%);
        filter: contrast(300%);
        mix-blend-mode: var(--screen);
        opacity: 0.35;
        z-index: -1;
      }

      section {
        margin-bottom: 4.5rem;

        &:last-of-type {
          margin-bottom: 2rem;
        }
      }

      h1 {
        text-wrap: balance;
        font:
          500 2rem/1.1 "Chivo Mono",
          serif;
        color: #fff;
      }

      h2 {
        text-wrap: balance;
        font:
          400 1rem/1 "Chivo Mono",
          serif;
        color: #fff;
        margin-bottom: 1.5rem;
      }

      h3 {
        font: var(--page-subtitle);
        color: var(--page-subtitle-color);
        margin-top: 0;
        margin-bottom: 0.4rem;
      }

      p {
        /* text-wrap: balance; */
        font:
          300 0.75rem/1.9 "Martian Mono",
          serif;
        color: rgb(112, 145, 176);
      }

      main,
      header {
        max-width: 35rem;
        margin: 0 auto;
        padding: 0 1rem;

        @media screen and (min-width: 600px) {
          & {
            padding: 0;
          }
        }
      }

      footer {
        font:
          300 0.65rem/1.65 "Martian Mono",
          serif;
        color: rgb(65, 85, 102);
        text-align: center;
        margin-bottom: 2rem;
      }

      /****************/
      /*  Animations  */
      /****************/
      @keyframes slideUp {
        from {
          transform: translateY(100%);
        }

        to {
          transform: translateY(0);
        }
      }

      @keyframes slideDown {
        from {
          transform: translateY(0);
        }

        to {
          transform: translateY(250%);
        }
      }

      @keyframes float {
        0% {
          transform: translatey(0);
        }
        50% {
          transform: translatey(-4px);
        }
        100% {
          transform: translatey(0);
        }
      }
    </style>
  </body>
</html>
