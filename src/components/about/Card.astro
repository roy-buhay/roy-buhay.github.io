---
import { Image } from "astro:assets";
import { about } from "@data/about";

type About = (typeof about)[number];
---

<section>
    <h2>Work History</h2>
    <div class="about">
        {
            about.slice(0, 3).map((data: About) => (
                <article class="about__experiences">
                    <Image class="about__img" src={`/images/${data.icon}`} alt={data.company} width={32} height={32} />
                    <span class="about__company">
                        <p class="about__title"> {data.company} </p>
                        <small class="about__date">{data.timestamp}</small>
                    </span>
                </article>
            ))
        }
    </div>
    <a href="/about" class="about__all" title="View Companies">View Companies</a>
</section>

<style lang="scss">
    .about {
        display: flex;
        align-items: flex-start;
        flex-direction: column;
        row-gap: 1rem;

        @media screen and (min-width: 550px) {
            & {
                flex-direction: row;
                column-gap: 2rem;
                row-gap: 0;
            }
        }

        &__all {
            display: inline-block;
            font: 300 0.85rem/1.5 "Inter", sans-serif;
            color: #6c6c6c;
            text-decoration: underline;
            margin-top: 2rem;
            padding: 0;
            text-decoration: none;

            &:after {
                content: "";
                position: absolute;
                bottom: 0;
                left: 0;
                right: 0;
                border-bottom: 1px solid #e3e3e3;
            }
        }

        &__experiences {
            display: flex;
            align-items: flex-start;
            column-gap: 0.8rem;
            flex: 1;
        }

        &__date {
            display: block;
            color: #9b9b9b;
            font-size: 75%;
            margin-top: 0.2rem;
            font-family: Inter;
        }

        &__title {
            font: 300 0.85rem/1.7 "Inter", sans-serif;;
            line-height: 1.7;
            margin: 0;
            color: #252525;
            display: -webkit-box;
            -webkit-box-orient: vertical;
            overflow: hidden;
            line-clamp: 1;
            -webkit-line-clamp: 1;
        }

        &__img {
            background-color: rgb(255, 255, 255);
            border-radius: 0.6rem;
            margin-top: 0.2rem;
        }
    }
</style>
