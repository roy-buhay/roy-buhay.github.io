---
import { Image } from "astro:assets";
import { about } from "@data/about";

type About = (typeof about)[number];
---

<section>
    <h2>Work History</h2>
    <div class="about">
        {
            about.slice(0, 3).map((data: About) => (
                <article class="about__experiences">
                    <Image class="about__img" src={`/images/${data.icon}`} alt={data.company} width={28} height={28} />
                    <span class="about__company">
                        <p class="about__title"> {data.company} </p>
                        <small class="about__date">{data.timestamp}</small>
                    </span>
                </article>
            ))
        }
    </div>
    <a href="/about" class="about__all" title="View Companies">View Companies</a>
</section>

<style lang="scss">
    .about {
        display: flex;
        align-items: flex-start;
        flex-direction: column;
        row-gap: 1rem;

        @media screen and (min-width: 550px) {
            & {
                flex-direction: row;
                column-gap: 2rem;
                row-gap: 0;
            }
        }

        &__all {
            display: inline-block;
            font: 400 0.7rem/1 "Martian Mono", serif;
            color: rgb(78, 107, 136);
            text-decoration: underline;
            margin-top: 1.1rem;
            padding: 0;
        }

        &__experiences {
            display: flex;
            align-items: flex-start;
            column-gap: 0.8rem;
        }

        &__date {
            display: block;
            color: rgb(113, 133, 153);
            font-size: 75%;
            margin-top: 0.1rem;
        }

        &__title {
            font-size: 0.75rem;
            font-weight: 300;
            line-height: 1.7;
            margin: 0;
            color: rgb(255, 255, 255);
        }

        &__img {
            background-color: rgb(255, 255, 255);
            border-radius: 0.5rem;
            margin-top: 0.2rem;
        }
    }
</style>
