---
import { Image } from "astro:assets";
import { projects } from "@data/projects";

interface Props {
    limit?: number;
    from?: "projects";
}

const { limit, from } = Astro.props;
const visibleProjects = typeof limit === "number" ? projects.slice(0, limit) : projects;
---

<div class="projects">
    {
        visibleProjects.map((project) => (
            <a
                href={`/projects/${project.title}${from === "projects" ? "?from=projects" : ""}`}
                class="projects__link"
                aria-label={`View ${project.title} project`}
            >
                <span class="projects__screens">
                    {project.screens.slice(0, 2).map((screen, index) => (
                        <Image
                            class="projects__screens_img"
                            src={`/images/${project.title}/${screen.path}`}
                            alt={`${project.title} screen ${index + 1}`}
                            width={280}
                            height={560}
                            loading="lazy"
                            decoding="async"
                        />
                    ))}
                </span>
            </a>
        ))
    }
</div>

<style lang="scss">
    .projects {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
        width: 100%;

        @media screen and (min-width: 550px) {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        &__link {
            position: relative;
            display: block;
            aspect-ratio: 1;
            text-decoration: none;
            transition:
                border-color 180ms ease,
                transform 180ms ease,
                box-shadow 180ms ease,
                scale 160ms cubic-bezier(0.22, 1, 0.36, 1);

            &:hover {
                transform: translateY(-3px);
            }

            &:focus-visible {
                outline: 2px solid #000;
                outline-offset: 3px;
            }
        }

        &__screens {
            position: relative;
            display: block;
            width: 100%;
            height: 100%;

            :global(.projects__screens_img) {
                position: absolute;
                top: 11%;
                width: auto;
                height: 88%;
                max-width: none;
                border-radius: 0.6rem;
                object-fit: cover;
                box-shadow: 0 0.8rem 1.8rem rgba(0, 0, 0, 0.16);
                transition: transform 220ms ease;

                &:first-child {
                    left: 8%;
                    z-index: 1;
                    transform: translateY(5%) rotate(-4deg);
                }

                &:last-child {
                    right: 12%;
                    z-index: 2;
                    top: 10%;
                    transform: rotate(3deg);
                }

                .projects__link:hover &:first-child {
                    transform: translate(-3%, 7%) rotate(-6deg);
                }

                .projects__link:hover &:last-child {
                    transform: translateX(3%) rotate(5deg);
                }
            }
        }
    }
</style>
