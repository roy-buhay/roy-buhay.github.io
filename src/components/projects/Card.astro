---
import { Image } from "astro:assets";
import { projects } from "@data/projects";

type Project = (typeof projects)[number];
---

<section>
    <h2>Selected Works</h2>
    <div class="projects">
        {
            projects.map((project: Project) => (
                <a
                    href={`projects/${project.title}`}
                    class="projects__link"
                    aria-label={`View ${project.title} project`}
                >
                    <span class="projects__screens">
                        {project.screens.slice(0, 2).map((screen, index) => (
                            <Image
                                class="projects__screens_img"
                                src={`/images/${project.title}/${screen.path}`}
                                alt={`${project.title} screen ${index + 1}`}
                                width={280}
                                height={560}
                                loading="lazy"
                                decoding="async"
                            />
                        ))}
                    </span>
                </a>
            ))
        }
    </div>
</section>

<style lang="scss">
    .projects {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
        margin-top: -0.5rem;

        @media screen and (min-width: 550px) {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        &__link {
            position: relative;
            display: block;
            aspect-ratio: 1;
            text-decoration: none;
            transition:
                border-color 180ms ease,
                transform 180ms ease,
                box-shadow 180ms ease,
                scale 160ms cubic-bezier(0.22, 1, 0.36, 1);

            &:hover {
                transform: translateY(-3px);
            }

            &:focus-visible {
                outline: 2px solid #000;
                outline-offset: 3px;
            }
        }

        &__screens {
            position: relative;
            display: block;
            width: 100%;
            height: 100%;

            &_img {
                position: absolute;
                top: 11%;
                width: auto;
                height: 88%;
                max-width: none;
                border-radius: 0.6rem;
                object-fit: cover;
                box-shadow: 0 0.8rem 1.8rem rgba(0, 0, 0, 0.16);
                transition: transform 220ms ease;

                &:first-child {
                    left: 8%;
                    z-index: 1;
                    transform: translateY(5%) rotate(-4deg);
                }

                &:last-child {
                    right: 12%;
                    z-index: 2;
                    transform: rotate(3deg);
                    top: 10%;
                }

                .projects__link:hover &:first-child {
                    transform: translate(-3%, 7%) rotate(-6deg);
                }

                .projects__link:hover &:last-child {
                    transform: translateX(3%) rotate(5deg);
                }
            }
        }

        &__title {
            position: absolute;
            left: 0.8rem;
            bottom: 0.8rem;
            z-index: 3;
            padding: 0.25rem 0.5rem;
            border-radius: 999px;
            background: rgba(248, 249, 249, 0.9);
            color: #000;
            font: 500 0.65rem/1.4 "Inter", sans-serif;
            text-transform: capitalize;
            backdrop-filter: blur(0.4rem);
        }
    }
</style>
