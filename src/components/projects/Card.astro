---
import ProjectGrid from "./Grid.astro";
---

<section>
    <h2>Recent Works</h2>
    <div class="recent-projects">
        <ProjectGrid limit={2} />
    </div>
    <a href="/projects" class="projects__all" title="View other works">View other works</a>
</section>

<style lang="scss">
    .recent-projects {
        margin-top: -1rem;
    }

    .projects__all {
        display: inline-block;
        position: relative;
        margin-top: 4rem;
        padding: 0;
        color: #6c6c6c !important;
        font: 300 0.85rem/1.5 "Inter", sans-serif;
        text-decoration: none;

        &:after {
            content: "";
            position: absolute;
            right: 0;
            bottom: 0;
            left: 0;
            border-bottom: 1px solid #e3e3e3;
        }
    }
</style>
