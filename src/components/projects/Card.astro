---
import { Image } from "astro:assets";
import { projects } from "@data/projects";

type Projects = (typeof projects)[number]["title"];
type Project = (typeof projects)[number];
---

<section>
    <h2>Selected Works</h2>
    <div class="projects">
        {
            projects.map((project: Project) => (
                <a href={`projects/${project.title}`} class="projects__link">
                    <span class="projects__info">
                        <Image
                            src={`/images/${project.title}/${project.icon}`}
                            alt={project.title}
                            width={24}
                            height={24}
                        />
                        <p class="projects__desc">{project.short_desc}</p>
                        <ul class="projects__tech">
                            {project.technologies.map((tech) => (
                                <li
                                    class="projects__tech_list"
                                    data-tooltip={tech}
                                >
                                    <img
                                        src={`/svg/${tech}.svg`}
                                        alt={tech}
                                    />
                                </li>
                            ))}
                        </ul>
                    </span>
                    <span class="projects__screens">
                        {project.screens.map((screen) => (
                            <span>
                                <Image
                                    class="projects__screens_img"
                                    src={`/images/${project.title}/${screen.path}`}
                                    alt={project.title}
                                    width={32}
                                    height={32}
                                />
                            </span>
                        ))}
                    </span>
                </a>
            ))
        }
    </div>
</section>

<style lang="scss">
    .projects {
        display: flex;
        flex-direction: column;
        row-gap: 1rem;

        &__link {
            background-color: rgba(29, 69, 101, 0.3);
            display: flex;
            align-items: center;
            flex-direction: column;
            border-radius: 0.6rem;
            padding: 0.6rem 0.6rem 0.6rem 1.2rem;
            text-decoration: none;
            transition:
                border 0.2s ease-in,
                scale 0.1s ease-in;
            border: 1px solid transparent;

            @media screen and (min-width: 550px) {
                & {
                    flex-direction: row;
                }
            }

            &:hover {
                border-color: rgb(40, 68, 98);
                scale: 1.01;
            }
        }

        &__desc {
            font:
                300 0.7rem/1.65 "Martian Mono", serif;
            color: rgb(122 149 172);
        }

        &__info {
            width: 100%;

            @media screen and (min-width: 550px) {
                & {
                    width: 55%;
                }
            }
        }

        &__tech {
            display: flex;
            align-items: center;
            justify-content: flex-start;
            column-gap: 0.6rem;
            padding-left: 0;

            &_list {
                list-style-type: none;
                position: relative;

                img {
                    width: 1.5rem;
                    height: 1.5rem;

                    @media screen and (min-width: 550px) {
                        & {
                            width: 1.3rem;
                            height: 1.3rem;
                        }
                    }
                }

                &:after {
                    content: attr(data-tooltip);
                    position: absolute;
                    top: 0.7rem;
                    left: 0.5rem;
                    z-index: 2;
                    visibility: hidden;
                    opacity: 0;
                    font: 300 0.65rem/1.6 "Martian Mono";
                    transition: all 0.1s ease-in;
                    background-color: rgb(255, 255, 255);
                    pointer-events: none;
                    border-radius: 0.5rem;
                    padding: 0 0.4rem;
                    color: rgb(9, 44, 86);
                    mix-blend-mode: color-dodge;
                }

                &:hover {
                    &::after {
                        visibility: visible;
                        top: -1rem;
                        opacity: 1;
                    }
                }
            }
        }

        &__screens {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: flex-start;
            width: 100%;

            @media screen and (min-width: 550px) {
                & {
                    justify-content: flex-end;
                }
            }

           
            & span {
                width: auto;
                height: 11rem;
                border-radius: 0.4rem;
                margin-left: -0.2rem;
                box-shadow: 0 0 1rem 0 rgba(4, 47, 84, 0.188);
                overflow: hidden;
                position: relative;
                z-index: 1;

                @media screen and (min-width: 550px) {
                    & {
                        margin-left: -1.5rem;
                    }
                }

                &:before {
                    content: "";
                    position: absolute;
                    z-index: 2;
                    width: 100%;
                    height: 100%;
                    background: radial-gradient(circle at 55% 100%,rgba(0,0,0,1),rgba(0,0,0,0)),url('images/noise.svg');
                    background-size: 10rem;
                    -webkit-filter: contrast(300%) brightness(100%);
                    filter: contrast(300%) brightness(100%);
                    opacity: 0.4;
                }


                & img {
                    width: 100%;
                    height: 100%;
                }
            }
        }
    }
</style>
