---
import { Image } from "astro:assets";
import { stacks } from "@data/stack.ts"
---

<section>
    <h2>Tech Stack</h2>
    <div class="stack">
        {stacks.map(stack => (
            <span class="stack__wrapper">
                <Image class="stack__icons" src={`/images/tech/${stack}.svg`} alt={`${stack}`} draggable="false" width={24} height={24} />
            </span>
        ))}
    </div>
</section>

<style lang="scss">
    .stack {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        flex-wrap: wrap;
        column-gap: 0.8rem;
        row-gap: 1rem;
        width: 100%;
        
        @media screen and (min-width: 550px) {
            & {
                width: 80%;
            }
        }

        &__wrapper {
            width: 2.3rem;
            height: 2.3rem;
            overflow: hidden;
            border-radius: 100%;
            position: relative;

            @media screen and (min-width: 550px) {
                & {
                    width: 2.6rem;
                    height: 2.6rem;
                }
            }

            &:before {
                content: "";
                position: absolute;
                z-index: 2;
                width: 100%;
                height: 100%;
                background: -o-linear-gradient(rgba(255, 0, 0, 0), var(--bg-color)), url("/images/noise.svg");
                background: -webkit-gradient(linear, left top, left bottom, from(rgba(255, 0, 0, 0)), to(var(--bg-color))), url("/images/noise.svg");
                background: linear-gradient(rgba(255, 0, 0, 0), var(--bg-color)), url("/images/noise.svg");
                background-size: 10rem;
                -webkit-filter: contrast(150%);
                filter: contrast(150%);
                opacity: 0.2;
            }

            &:nth-child(1):before {
                --bg-color: rgba(59, 107, 170, 0.3);
            }
            &:nth-child(2):before {
                --bg-color: rgba(25, 26, 28, 0.46);
            }
            &:nth-child(3):before {
                --bg-color: rgba(72, 78, 89, 0.46);
            }
            &:nth-child(4):before {
                --bg-color: rgb(66 121 168);
            }
            &:nth-child(5):before {
                --bg-color: rgb(123, 106, 88);
            }
            &:nth-child(6):before {
                --bg-color: rgb(106, 98, 95);
            }
            &:nth-child(7):before {
                --bg-color: rgb(106, 98, 95);
            }
            &:nth-child(8):before {
                --bg-color: rgb(106, 98, 95);
            }
            &:nth-child(9):before {
                --bg-color: rgb(247 156 217);
            }
            &:nth-child(10):before {
                --bg-color: rgb(98 94 97);
            }
            &:nth-child(11):before {
                --bg-color: rgb(98 94 97);
            }
            &:nth-child(12):before {
                --bg-color: rgb(44 44 44);
            }
        }

        &__icons {
            width: 100%;
            height: 100%;
        }
    }
</style>