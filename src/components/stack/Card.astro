---
import { Image } from "astro:assets";
import { stacks } from "@data/stack.ts"

const stackNames: Record<string, string> = {
    css: "CSS",
    html: "HTML",
    js: "JavaScript",
    ts: "TypeScript",
    react: "React",
    react_native: "React Native",
    expo: "Expo",
    tailwind: "Tailwind CSS",
    nextjs: "Next.js",
    node: "Node.js",
    express: "Express",
    supabase: "Supabase",
    aws: "AWS",
};
---

<section>
    <h2>Tech Stack</h2>
    <div class="stack">
        {stacks.map(stack => (
            <span class="stack__wrapper" data-tooltip={stackNames[stack] || stack}>
                <Image class="stack__icons" src={`/images/tech/${stack}.svg`} alt={stackNames[stack] || stack} draggable="false" width={24} height={24} />
            </span>
        ))}
    </div>
</section>

<style lang="scss">
    .stack {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        flex-wrap: wrap;
        column-gap: 0.6rem;
        row-gap: 0.6rem;
        width: 100%;

        @media screen and (min-width: 550px) {
            & {
                width: 80%;
                column-gap: 0.8rem;
                row-gap: 1rem;
            }
        }

        &__wrapper {
            width: 2.5rem;
            height: 2.5rem;
            overflow: hidden;
            border-radius: 100%;
            position: relative;

            @media screen and (min-width: 550px) {
                & {
                    width: 2.4rem;
                    height: 2.4rem;
                }
            }

            &:hover {
                overflow: visible;
            }

            &:before {
                content: "";
                position: absolute;
                inset: 0;
                z-index: 2;
                border-radius: 100%;
                mix-blend-mode: soft-light;
                opacity: 0.42;
                pointer-events: none;
            }

            &:after {
                content: attr(data-tooltip);
                position: absolute;
                top: 0.7rem;
                left: 50%;
                transform: translateX(-50%);
                z-index: 3;
                visibility: hidden;
                opacity: 0;
                font: 300 0.65rem/1.6 "JetBrains Mono", monospace;
                transition: all 0.1s ease-in;
                background-color: rgb(255, 255, 255);
                pointer-events: none;
                border-radius: 0.5rem;
                padding: 0 0.4rem;
                color: rgb(9, 44, 86);
                mix-blend-mode: color-dodge;
                white-space: nowrap;
            }

            &:hover {
                &::after {
                    visibility: visible;
                    top: -1rem;
                    opacity: 1;
                }
            }

            &:nth-child(1):before {
                --bg-color: rgba(59, 107, 170, 0.3);
            }
            &:nth-child(2):before {
                --bg-color: rgba(25, 26, 28, 0.46);
            }
            &:nth-child(3):before {
                --bg-color: rgba(72, 78, 89, 0.46);
            }
            &:nth-child(4):before {
                --bg-color: rgb(66 121 168);
            }
            &:nth-child(5):before {
                --bg-color: rgb(123, 106, 88);
            }
            &:nth-child(6):before {
                --bg-color: rgb(106, 98, 95);
            }
            &:nth-child(7):before {
                --bg-color: rgb(106, 98, 95);
            }
            &:nth-child(8):before {
                --bg-color: rgb(106, 98, 95);
            }
            &:nth-child(9):before {
                --bg-color: rgb(247 156 217);
            }
            &:nth-child(10):before {
                --bg-color: rgb(98 94 97);
            }
            &:nth-child(11):before {
                --bg-color: rgb(98 94 97);
            }
            &:nth-child(12):before {
                --bg-color: rgb(44 44 44);
            }
        }

        &__icons {
            width: 100%;
            height: 100%;
            border-radius: 100%;
        }
    }
</style>
