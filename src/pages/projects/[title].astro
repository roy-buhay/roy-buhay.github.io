---
import { Image } from "astro:assets";
import Layout from "@layout/Layout.astro";
import Close from "@components/Close.astro";

import { projects } from "@data/projects";

type Project = (typeof projects)[number];

export function getStaticPaths() {
  return projects.map(({ title, app, desc, contribution, highlights, technologies, screenshots, icon, pageWidth, width, url, urlText }: Project) => {
    return {
      params: { title },
      props: { title, app, desc, contribution, highlights, technologies, screenshots, icon, pageWidth, width, url, urlText },
    };
  });
}

const { title, app, desc, contribution, highlights, technologies, screenshots, icon, pageWidth, width, url, urlText } = Astro.props;

const technologyNames: Record<string, string> = {
  react: "React",
  reactnative: "React Native",
  nextjs: "Next.js",
  node: "Node.js",
  typescript: "TypeScript",
  javascript: "JavaScript",
  expo: "Expo",
  figma: "Figma",
  supabase: "Supabase",
  elevenlabs: "ElevenLabs",
  reactnativetestinglibrary: "RNTL",
  maestro: "Maestro",
  claudecode: "Claude Code",
  zustand: "Zustand",
  mmkv: "MMKV",
  postgres: "PostgreSQL",
  mapsplacesapi: "Maps & Places APIs",
  openaiwhisper: "OpenAI Whisper",
  reactnativegiftedcharts: "React Native Gifted Charts",
  openai: "OpenAI",
  reactquery: "React Query",
  nodeexpress: "Node.js / Express",
};

const technologyIcons: Record<string, string> = {
  elevenlabs: "/images/tech/elevenlabs.svg",
  reactnativetestinglibrary: "/images/tech/rntl.svg",
  maestro: "/images/tech/maestro.svg",
  openaiwhisper: "/images/tech/openAI.svg",
  openai: "/images/tech/openAI.svg",
  zustand: "/images/tech/zustand.svg",
  claudecode: "/svg/react.svg",
  mmkv: "/images/tech/mmkv.svg",
  postgres: "/svg/react.svg",
  mapsplacesapi: "/svg/react.svg",
  reactnativegiftedcharts: "/svg/react.svg",
  reactquery: "/svg/react.svg",
  nodeexpress: "/svg/node.svg",
};

const projectName = app;
const projectDescription = desc.trim();
const projectSummary = contribution?.trim()
  || (!highlights?.length ? projectDescription : "");
const socialImage = `/images/${title}/${screenshots[0].path}`;
const caseStudyMetaDescriptions: Record<string, string> = {
  blush: "Blush is an on-demand audiobook app designed and built by Roy Jose Buhay, using ElevenLabs text-to-speech and a Supabase Edge Function.",
  ubaware: "UBAware is a location-aware alerts app designed and built by Roy Jose Buhay, using external data sources and a triage system for more accurate alerts.",
  dreamowl: "DreamOwl is an AI dream journal designed and built by Roy Jose Buhay, using OpenAI Whisper and a Supabase Edge Function to process spoken dream entries.",
  rocky: "Rocky is a gamified breakup recovery app designed and built by Roy Jose Buhay, using OpenAI chat, Supabase, and native iOS home-screen widgets.",
  get2germany: "Get2Germany's React Native app was modernized by Roy Jose Buhay with React Query, Zustand, MMKV, cleaner architecture, and production profiling.",
  avazoo: "Avazoo's outdated mobile app was redesigned and rebuilt by Roy Jose Buhay with modern architecture, social SDK integrations, and a production-ready release.",
  matchit: "MatchIt was redesigned and rebuilt by Roy Jose Buhay with modern React architecture, performance improvements, and embeddable web and mobile integrations.",
};
const rawMetaDescription = caseStudyMetaDescriptions[title]
  ?? `${projectDescription} Explore the design and development work behind ${projectName}.`;
const metaDescription = rawMetaDescription.length <= 160
  ? rawMetaDescription
  : `${rawMetaDescription.slice(0, 157).replace(/\s+\S*$/, "")}...`;

const externalUrl = url;
const siteUrl = Astro.site ?? new URL("https://roy-buhay.github.io");

const projectSchema = {
  "@type": "CreativeWork",
  name: `${projectName} case study`,
  description: projectDescription,
  url: new URL(`/projects/${title}/`, siteUrl).href,
  image: new URL(socialImage, siteUrl).href,
  creator: { "@id": new URL("/#person", siteUrl).href },
};

type ProjectDetailCell =
  | { type: "image"; path: string; alt: string; class?: string }
  | { type: "text"; body: string }
  | { type: "media-text"; path: string; alt: string; body: string; class?: string }
  | { type: "empty" };

// Custom bottom rows can mix images, copy, and empty cells without changing
// the existing project data or screenshot gallery.
const customProjectDetails: Record<string, ProjectDetailCell[][]> = {
  blush: [
    [
      {
        type: "image",
        path: "blush_1.webp",
        alt: "Blush home screen with featured and trending audio stories",
      },
      {
        type: "image",
        path: "blush_4.webp",
        alt: "Blush discover screen with ranked and categorized stories",
        class: "discover",
      },
      {
        type: "media-text",
        path: "cards.webp",
        alt: "Blush ranked story cards and play counts",
        class: "cards",
        body: "I built reusable React Native components for story cards, content rails, filters, and navigation, maintaining consistent layouts and visual hierarchy across screen sizes.",
      },
    ],
    [
      {
        type: "image",
        path: "blush_2.webp",
        alt: "Blush full audio player for an active story chapter",
      },
      {
        type: "image",
        path: "blush_3.webp",
        alt: "Blush playback controls and persistent mini-player states",
      },
      {
        type: "media-text",
        path: "player.webp",
        alt: "Blush full-player controls and persistent mini-player",
        class: "cards2",
        body: "I used Zustand to synchronize the story page, full player, mini-player, and reading/listening progress, with MMKV restoring the listener’s session after relaunch.",
      },
    ],
    [
      {
        type: "image",
        path: "blush_5.webp",
        alt: "Blush Midnight Reader badge unlocked screen",
      },
      {
        type: "image",
        path: "blush_6.webp",
        alt: "Blush three-day listening streak screen",
        class: "streak",
      },
      {
        type: "media-text",
        path: "badges.webp",
        alt: "Blush achievement badge and listening streak states",
        class: "cards3",
        body: "I built reusable badge and streak states with consistent presentation, reward logic, and a clear return to the listening experience.",
      },
    ],
  ],
  ubaware: [
    [
      {
        type: "image",
        path: "ubaware_0.webp",
        alt: "UBAware onboarding screen introducing location-aware discovery",
      },
      {
        type: "image",
        path: "ubaware_1.webp",
        alt: "UBAware map showing nearby places, distances, and active alerts",
      },
      {
        type: "media-text",
        path: "markers.webp",
        alt: "UBAware nearby-place cards and branded map markers",
        class: "markers",
        body: "I built reusable map markers, nearby-place cards, distance indicators, and navigation states around the user's current location.",
      },
    ],
    [
      {
        type: "image",
        path: "ubaware_2.webp",
        alt: "UBAware place panel with travel time, distance, and route options",
      },
      {
        type: "image",
        path: "ubaware_3.webp",
        alt: "UBAware active event details for a nearby venue",
      },
      {
        type: "media-text",
        path: "panels.webp",
        alt: "UBAware active-event rating, route, and travel-mode controls",
        class: "panels",
        body: "I connected place details, route options, ratings, and active events into contextual panels that preserve the map behind each interaction.",
      },
    ],
    [
      {
        type: "image",
        path: "ubaware_4.webp",
        alt: "UBAware grid of local events happening this week",
      },
      {
        type: "image",
        path: "ubaware_5.webp",
        alt: "UBAware profile with preferences and map theme controls",
      },
      {
        type: "media-text",
        path: "events.webp",
        alt: "UBAware event cards for nearby offers and activities",
        class: "panels",
        body: "I built reusable event cards and preference states so users can browse nearby activity and control how location-based information is presented.",
      },
    ],
  ],
};

const projectDetailRows = customProjectDetails[title] ?? [];

---

<Layout
  title={`${projectName} Case Study | Roy Jose Buhay`}
  description={metaDescription}
  image={socialImage}
  type="article"
  structuredData={projectSchema}
>
   <main>
     <div class="container">
        <div class="content">          
          <div>
            <Close contextualProjects />
            <Image class="logo" src={`/images/${title}/${icon}`} style={{width: `${width}rem`}} alt={`${projectName} logo`} width={26} height={26} />
            <h1>{projectName}</h1>
            <!-- {projectSummary && <p class="desc">{projectSummary}</p>} -->
            <div class="tech">
              {technologies.map(tech => (
                <span class="tech__img">
                  <Image src={technologyIcons[tech] ?? `/svg/${tech}.svg`} alt="" width={26} height={26} />
                  <span>{technologyNames[tech] ?? tech}</span>
                </span>
              ))}
            </div>
            {highlights?.length > 0 && (
              <section class="case-study" aria-labelledby="highlights-heading">
                <h2 id="highlights-heading">Selected highlights</h2>
                <ul>
                  {highlights.map((highlight: string) => <li>{highlight}</li>)}
                </ul>
              </section>
            )}
            {externalUrl && <a class="link" href={externalUrl} target="_blank" rel="noopener noreferrer">
              {urlText && !urlText.startsWith("http") ? urlText : `View ${projectName}`}
              <svg width="12" height="12" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3.39961 12.598C3.30584 12.5042 3.25316 12.377 3.25316 12.2444C3.25316 12.1118 3.30584 11.9846 3.39961 11.8908L11.0314 4.25904L5.16737 4.25904C5.03629 4.25676 4.91135 4.20309 4.81945 4.10958C4.72756 4.01608 4.67606 3.89022 4.67606 3.75912C4.67606 3.62801 4.72756 3.50216 4.81945 3.40865C4.91135 3.31514 5.03629 3.26147 5.16737 3.25919L12.2384 3.25919C12.371 3.25921 12.4982 3.31189 12.5919 3.40564C12.6857 3.49939 12.7383 3.62654 12.7384 3.75912L12.7384 10.8302C12.7395 10.8966 12.7274 10.9625 12.7028 11.0242C12.6782 11.0858 12.6416 11.142 12.5951 11.1893C12.5485 11.2367 12.493 11.2743 12.4318 11.3C12.3706 11.3257 12.3048 11.3389 12.2384 11.3389C12.172 11.3389 12.1063 11.3257 12.0451 11.3C11.9839 11.2743 11.9284 11.2367 11.8818 11.1893C11.8353 11.142 11.7987 11.0858 11.774 11.0242C11.7494 10.9625 11.7374 10.8966 11.7385 10.8302L11.7385 4.96615L4.10671 12.598C4.01295 12.6917 3.88577 12.7444 3.75316 12.7444C3.62055 12.7444 3.49338 12.6917 3.39961 12.598Z" fill="#A1B1BF"/>
              </svg>
            </a>}
          </div>
        </div>
        {projectDetailRows.length === 0 && (
          <div class="screenshots stagger-section stagger-section--2" aria-label="Screenshots">
            {screenshots.map((screen, index) => (
              <figure
                class:list={[
                  "screenshots__item",
                  `screenshots__item--${screen.class}`,
                ]}
                style={`--screenshot-index: ${index}`}
              >
                <Image
                  class="screenshots__img"
                  src={`/images/${title}/${screen.path}`}
                  alt={`${projectName} product screen ${index + 1}`}
                  width={600}
                  height={1200}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            ))}
          </div>
        )}
        {projectDetailRows.length > 0 && (
          <section class="custom-details" aria-label={`${projectName} design and implementation details`}>
            {projectDetailRows.map((row, rowIndex) => (
              <div
                class:list={[
                  "custom-details__row",
                  "stagger-section",
                  `stagger-section--${rowIndex + 2}`,
                ]}
              >
                {row.map((cell) => (
                  <div
                    class:list={["custom-details__cell", `custom-details__cell--${cell.type}`]}
                  >
                    {cell.type === "image" && (
                      <Image
                        class:list={[
                          "custom-details__img",
                          cell.class && `custom-details__img--${cell.class}`,
                        ]}
                        src={`/images/${title}/${cell.path}`}
                        alt={cell.alt}
                        width={600}
                        height={1200}
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                    {cell.type === "media-text" && (
                      <>
                        <Image
                          class:list={[
                            "custom-details__img",
                            cell.class && `custom-details__img--${cell.class}`,
                          ]}
                          src={`/images/${title}/${cell.path}`}
                          alt={cell.alt}
                          width={600}
                          height={1200}
                          loading="lazy"
                          decoding="async"
                        />
                        <p>{cell.body}</p>
                      </>
                    )}
                    {cell.type === "text" && <p>{cell.body}</p>}
                  </div>
                ))}
              </div>
            ))}
          </section>
        )}
     </div>
   </main>
</Layout>

<style lang="scss">
  main {
    width: 100%;
    height: auto;
    max-width: 37rem;
    margin: 0 auto;
    padding-inline: 1rem;
    display: flex;
    flex-direction: column;

    @media screen and (min-width: 900px) {
      & {
        max-width: 64rem;
        padding-inline: 2rem;
      }
    }
  }

  .container {
    display: flex;
    align-items: center;
    justify-items: center;
    flex-direction: column;
    animation: none;
  }

  .logo {
    width: 8rem;
    height: auto;
    margin-top: 2rem;
    // box-shadow: 0 1px 5px 0 #ededed;
    // border-radius: 18px;
  }

  h1 {
    margin: 1.5rem 0 2.5rem;
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    font: 400 1rem/1 "Inter", monospace;
    letter-spacing: 0.5px;
  }


  .content {
    width: 100%;
    max-width: 37rem;
    height: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    margin: 9rem auto 2rem;
  }

  .tech {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    column-gap: 0.6rem;
    row-gap: 0.4rem;
    margin-top: 1.5rem;

    @media screen and (min-width: 900px) {
        & {
          column-gap: 1.3rem;
          row-gap: 0.8rem;
        }
    }

    &__img {
      display: flex;
      align-items: center;
      column-gap: 0.4rem;
      font: 400 0.85rem/1.65 "Inter",monospace;
      color: #4c4c4c;
      text-transform: capitalize;
      letter-spacing: 0.1px;
      // padding: 0.2rem 0.6rem;
      // border-radius: 1rem;
      // background: rgba(253,253,253,0.72);
      // border: 1px solid rgba(255,255,255,0.72);

      @media screen and (min-width: 900px) {
          & {
            column-gap: 0.5rem;
          }
      }
    }
  }

  .case-study {
    margin: 3.5rem 0 0;

    h2 {
      margin: 1.8rem 0 0.7rem;
      font: 300 0.9rem/1.7 "Inter",sans-serif;
      letter-spacing: 0.2px;
    }

    li {
      color: #6c6c6c;
      font: 300 0.85rem/1.6 "Inter",sans-serif;
      letter-spacing: 0;
      list-style: none;
      margin-bottom: 1rem;

      &::before {
        content: "•";
        display: inline-block;
        margin-right: 0.6rem;
        font-size: 0.5rem;
        position: relative;
        top: -0.1rem;
        color: #9b9b9b;
      }
    }

    ul {
      margin: 0;
      padding: 0;
    }
  }

  .link {
    display: inline-flex;
    margin-top: 2rem;
    font: 300 0.85rem/2 "Inter",sans-serif;
    color: #353535;
    letter-spacing: 0px;
    text-decoration: none;

    svg {
      position: relative;
      top: 8px;
      left: 3px;
    }

    &:after {
        content: "";
        position: absolute;
        bottom: 2px;
        left: 0px;
        right: 0px;
        border-bottom: 1px solid #d4d4d4;
    }
  }

  .screenshots {
    display: grid;
    grid-template-columns: 1fr;
    align-items: start;
    gap: 1rem;
    width: 100%;
    max-width: 60rem;
    margin-inline: auto;
    margin-top: 5rem;

    @media screen and (min-width: 550px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @media screen and (min-width: 900px) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    &__item {
      min-width: 0;
      margin: 0;
      border-radius: 0.8rem;
      overflow: hidden;
    }

    &__item--desktop {
      @media screen and (min-width: 550px) {
        grid-column: span 2;
      }
    }

    &__img {
      display: block;
      width: 100%;
      height: auto;
    }
  }

  .custom-details {
    width: 100%;
    max-width: 60rem;
    margin: 8rem auto 3rem;

    &__row {
      display: grid;
      grid-template-columns: 1fr;
      align-items: end;
      gap: 1.2rem;

      & + & {
        margin-top: 3rem;
      }

      @media screen and (min-width: 550px) {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    &__cell {
      min-width: 0;
    }

    &__cell--image {
      overflow: visible;
    }

    &__cell--text,
    &__cell--media-text {
      padding: 0.25rem 0 0.75rem 2rem;

      p {
        max-width: 17rem;
        margin: 0 0 3rem 0;
        color: #4d4d4d;
        font: 300 0.85rem/1.6 "Inter", sans-serif;
      }
    }

    &__cell--media-text &__img {
      display: none;

      @media screen and (min-width: 900px) {
        display: block;
      }
    }

    &__img {
      display: block;
      width: 100%;
      height: auto;
      border-radius: 0.8rem;
    }

    // &__img--player {
    //   position: relative;
    //   z-index: 2;
    //   left: 0;
    //   top: 0;
    //   width: calc(100%);
    //   height: auto;
    //   max-width: none;
    //   border-radius: 0;
    //   object-fit: contain;
    // }

    &__img--discover {
      // top: 6rem;
      position: relative;
    }

    &__img--streak {
      position: relative;
      // top: -3.5rem;
    }

    &__img--cards {
      margin-bottom: 1.5rem;
      border-radius: 0;
    }

    &__img--cards2 {
      margin-bottom: 1.5rem;
      border-radius: 0;
      width: 22rem;
      max-width: unset;
      left: -1.5rem;
      position: relative;
    }

    &__img--cards3 {
      margin-bottom: 1rem;
      border-radius: 0;
      width: 18rem;
      max-width: unset;
    }

    &__img--markers {
      max-width: unset;
      width: 19rem;
      position: relative;
      left: -2rem;
    }

    &__img--panels {
      max-width: unset;
      width: 19rem;
      position: relative;
      left: -1rem;
    }
  }

  .stagger-section {
    animation: customDetailFadeInUp 600ms cubic-bezier(0.22, 1, 0.36, 1) both;

    &--1 { animation-delay: 80ms; }
    &--2 { animation-delay: 180ms; }
    &--3 { animation-delay: 280ms; }
    &--4 { animation-delay: 380ms; }
    &--5 { animation-delay: 480ms; }
  }

  .content > div > :global(.back),
  .content > div > .logo,
  .content > div > h1,
  .content > div > .tech,
  .content > div > .case-study,
  .content > div > .link {
    animation: customDetailFadeInUp 600ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .content > div > :global(.back) { animation-delay: 80ms; }
  .content > div > .logo { animation-delay: 180ms; }
  .content > div > h1 { animation-delay: 280ms; }
  .content > div > .tech { animation-delay: 380ms; }
  .content > div > .case-study { animation-delay: 480ms; }
  .content > div > .link { animation-delay: 580ms; }

  @keyframes customDetailFadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stagger-section,
    .content > div > :global(.back),
    .content > div > .logo,
    .content > div > h1,
    .content > div > .tech,
    .content > div > .case-study,
    .content > div > .link {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
