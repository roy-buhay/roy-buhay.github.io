---
import Close from "@components/Close.astro";
import ProjectGrid from "@components/projects/Grid.astro";
import Layout from "@layout/Layout.astro";
---

<Layout
    title="Mobile & Web Projects | Roy Jose Buhay"
    description="Explore mobile and web products designed and developed by Roy Jose Buhay using React Native, Expo, TypeScript, Node.js, and modern UI/UX practices."
>
    <main>
        <Close />
        <h1>All Works</h1>
        <ProjectGrid from="projects" archive />
    </main>
</Layout>

<style lang="scss">
    main {
        width: 100%;
        max-width: 37rem;
        margin: 2rem auto 4rem;

        @media screen and (min-width: 550px) {
            margin-top: 9rem;
        }

        h1 {
            margin: 2rem 0 2.5rem;
            font-size: 1.5rem;
        }
    }
</style>
